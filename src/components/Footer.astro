<footer class="border-t border-white/10 mt-10">
  <div class="wrap grid gap-10 py-14 md:grid-cols-[1.4fr_1fr_1fr]">
    <div>
      <a href="index.html" class="flex items-center gap-2.5 font-display font-semibold">
        <img src="/logo-64.png" alt="" width="28" height="28" class="size-7" />
        Explore<span class="text-gold -ml-2.5">NDMU</span>
      </a>
      <p class="mt-4 max-w-sm text-sm leading-relaxed text-mute">
        An augmented reality campus tour, navigation and information app for Notre Dame of Marbel University,
        Koronadal City. A BS Information Technology capstone project.
      </p>
    </div>
    <div class="text-sm">
      <p class="font-mono text-xs uppercase tracking-[.14em] text-gold">Explore</p>
      <ul class="mt-4 space-y-2.5 text-mute">
        <li><a class="hover:text-paper" href="index.html#features">Features</a></li>
        <li><a class="hover:text-paper" href="index.html#how">How it works</a></li>
        <li><a class="hover:text-paper" href="index.html#engineering">Engineering notes</a></li>
        <li><a class="hover:text-paper" href="research.html">Research</a></li>
