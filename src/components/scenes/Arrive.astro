---
// Arrive and learn: the gold pin and the place card. The capture is real; the card beside it is the same
// information-card text the app ships (src/data/info-cards.json), set in the app's card style.
import SceneHead from '../SceneHead.astro';
import Device from '../Device.astro';
import Clip from '../Clip.astro';
import cards from '../../data/info-cards.json';
import { scenes } from '../../data/scenes';
const me = scenes.find((s) => s.id === 'arrive')!;
const card = cards.cards.find((c) => c.name === 'University Library')!;
const rows = card.schedule.map((s) => { const i = s.indexOf(':'); return { day: s.slice(0, i), time: s.slice(i + 1).trim() }; });
---
<section class="scene pin-scene arrive" id="arrive" data-scene data-travel={me.travel} style="--len: 2">
  <div class="pin">
    <div class="wrap arrive__grid">
      <div class="arrive__copy">
        <SceneHead id="arrive" title="Arrive and learn." lead="A gold pin marks the place. Above it, a card tells you what the place is for, when it is open and what you can do there." />
        <p class="t-voice arrive__say rv">“You have arrived.”</p>
      </div>
      <div class="arrive__stage">
        <Device class="arrive__device">
          <Clip name="arrive" label="Screen recording: a gold pin stands at the Library entrance and the University Library card floats above it" />
        </Device>
        <article class="app-card arrive__card" data-arrive-card aria-label="The University Library card, with the text the app shows">
          <header class="arrive__cardhead" data-arrive-part>
            <span class="app-tile"><i class="fi-rr-door-open" aria-hidden="true"></i></span>
            <div>
              <h3>{card.name}</h3>
              <p class="app-soft t-small" style="color:#c9d8ce">Place card, as written in the app</p>
            </div>
          </header>
          <div data-arrive-part>
            <p class="app-label">ABOUT</p>
            <p class="arrive__about">{card.about}</p>
          </div>
          <div data-arrive-part>
            <p class="app-label">SCHEDULE</p>
            <dl class="arrive__hours">
              {rows.map((r) => <><dt>{r.day}</dt><dd>{r.time}</dd></>)}
            </dl>
          </div>
          <div data-arrive-part class="arrive__services">
            <p class="app-label">SERVICES</p>
            <ul>{card.services.slice(0, 4).map((s) => <li class="app-chip">{s}</li>)}</ul>
          </div>
        </article>
      </div>
    </div>
  </div>
</section>

<style is:global>
  .arrive__grid { height: 100%; display: grid; gap: 1rem; grid-template-rows: auto minmax(0, 1fr); padding-top: calc(var(--header-h) + 0.75rem); padding-bottom: calc(var(--tourbar-h) + 1.75rem); }
  .arrive__copy { display: grid; gap: clamp(0.75rem, 2vh, 1.5rem); align-content: center; }
  .arrive__say { font-size: clamp(1.5rem, 3.2vw, 2.6rem); color: var(--color-gold-deep); line-height: 1.1; }
  .arrive__stage { position: relative; min-height: 0; display: grid; place-items: center; }
  .arrive__device { height: 100%; max-height: 36rem; aspect-ratio: 5.36 / 8.36; }
  .arrive__device .device { height: 100%; width: auto; }
  .arrive__card { position: absolute; z-index: 2; width: min(100%, 23rem); display: grid; gap: 0.9rem; font-size: 0.9rem; will-change: transform, opacity; }
  .arrive__cardhead { display: flex; align-items: center; gap: 0.8rem; }
  .arrive__cardhead h3 { font-size: 1.15rem; }
  .arrive__about { margin-top: 0.3rem; line-height: 1.45; color: #fff; display: -webkit-box; -webkit-line-clamp: 4; line-clamp: 4; -webkit-box-orient: vertical; overflow: hidden; }
  .arrive__hours { margin: 0.35rem 0 0; display: grid; grid-template-columns: 1fr auto; gap: 0.25rem 1rem; }
  .arrive__hours dt { color: #c9d8ce; }
  .arrive__hours dd { margin: 0; font-weight: 600; color: #fff; text-align: right; }
  .arrive__services ul { list-style: none; margin: 0.4rem 0 0; padding: 0; display: grid; gap: 0.35rem; }
  @media (max-width: 59.99rem) {
    .arrive .scene-head .t-lead { font-size: 1rem; }
    .arrive__say { display: none; }
    .arrive__card { bottom: 0; left: 50%; margin-left: max(-50%, -11.5rem); padding: 1rem; gap: 0.6rem; font-size: 0.82rem; }
    .arrive__services { display: none; }
    .arrive__about { -webkit-line-clamp: 3; line-clamp: 3; }
  }
  @media (min-width: 60rem) {
    .arrive__grid { grid-template-rows: none; grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr); align-items: center; gap: clamp(2rem, 5vw, 5rem); }
    .arrive__stage { height: 100%; justify-items: start; }
    .arrive__device { margin-left: 4%; }
    .arrive__card { right: 0; top: 50%; margin-top: -15rem; }
  }
  html.reduced .arrive__grid, html.no-js .arrive__grid { height: auto; padding-block: 6rem 4rem; }
  html.reduced .arrive__stage, html.no-js .arrive__stage { gap: 1.5rem; justify-items: center; }
  html.reduced .arrive__card, html.no-js .arrive__card { position: relative; inset: auto; margin: 0; }
  html.reduced .arrive__device, html.no-js .arrive__device { height: auto; width: min(100%, 18rem); margin: 0; }
  html.reduced .arrive__device .device, html.no-js .arrive__device .device { height: auto; width: 100%; }
</style>
