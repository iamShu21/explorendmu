---
// The real campus walk network: every route the team walked with GPS (Oct 30, 2026 export),
// projected to a flat SVG. Used as the hero backdrop and in "How it works".
import net from '../data/campus-network.json';
interface Props { id: string; variant?: 'hero' | 'map'; class?: string; }
const { id, variant = 'map', class: cls = '' } = Astro.props;
const hero = variant === 'hero';
const labelled = new Set(['Library', 'Gate 01', 'Gate 02', 'Gate 03', 'Gate 04', 'University Gym', 'Clinic', 'Teston Hall', 'Business Office', 'QAPS', 'OSAD', 'Alumni Center', 'SMC Hall']);
---
<svg
  id={id}
  class={cls}
  viewBox={`0 0 ${net.width} ${net.height}`}
  role="img"
  aria-label={`Map of the ${net.counts.walked} routes the team walked across ${net.counts.places} campus places`}
  data-network={variant}
  preserveAspectRatio="xMidYMid meet"
>
  <defs>
    <filter id={`${id}-glow`} x="-50%" y="-50%" width="200%" height="200%">
      <feGaussianBlur stdDeviation="3" result="b" />
      <feMerge><feMergeNode in="b" /><feMergeNode in="SourceGraphic" /></feMerge>
    </filter>
  </defs>
  <g fill="none" stroke-linecap="round" stroke-linejoin="round">
    <g class="net-base" stroke={hero ? 'rgba(95,211,149,.22)' : 'rgba(95,211,149,.45)'} stroke-width={hero ? 2 : 2.4}>
      {net.walks.map((w) => <path d={w.d} data-walk><title>{w.name}</title></path>)}
    </g>
    <g class="net-pulse" stroke="#ffc20e" stroke-width={hero ? 3 : 3.4} filter={`url(#${id}-glow)`} opacity="0">
      {net.walks.map((w) => <path d={w.d} data-pulse />)}
    </g>
  </g>
  <g class="net-places">
    {net.places.map((p) => (
      <g class="net-place" data-place={p.name} transform={`translate(${p.x} ${p.y})`}>
        <circle r={hero ? 4 : 6} fill={p.name.startsWith('Gate') ? '#ffc20e' : '#5fd395'} />
        {!hero && labelled.has(p.name) && (
          <text x="10" y="4" font-size="17" font-family="Inter Variable, sans-serif" fill="rgba(244,242,234,.85)" paint-order="stroke" stroke="#050f0a" stroke-width="4">{p.name}</text>
        )}
        <title>{p.name}</title>
      </g>
    ))}
  </g>
</svg>
