---
// Milestones from the build log (all 2026).
const items = [
  { date: 'The start', title: 'One route: Gate 03 to the Library', text: 'The first walked route proved the idea: GPS to find the start, the AR session to follow it, arrows on the ground.' },
  { date: 'Oct 14', title: 'Navigate here opens AR', text: 'Place details hand the chosen route straight to the AR scene inside the main app. Exit returns you to the place.' },
  { date: 'Oct 15', title: 'Arrival info cards', text: 'A floating card appears above the destination, using text written for each place.' },
  { date: 'Oct 17', title: 'A motion layer', text: 'Ripple on press, a liquid pill in the bottom bar, spring physics on buttons. Reduced motion is respected.' },
  { date: 'Oct 18', title: '3D statues on printed markers', text: 'Mother Mary, Champagnat and the Bronze Stallion, with AR Foundation image tracking and a centre Scan tab.' },
  { date: 'Oct 20', title: 'Walking the campus', text: 'Field walks with NDMU Walker, the team’s own recording app, put half of the 38 target places on the map.' },
  { date: 'Oct 21', title: 'AR navigation v2', text: 'Gold destination pin with a beam, a cleaner screen, and spoken turn-by-turn voice guidance.' },
  { date: 'Oct 22', title: 'The performance pass', text: 'Profiling found the dark theme doing work for every graphic every frame. Cached, and the stutter went away.' },
  { date: 'Oct 27', title: 'Dijkstra route builder', text: 'Walked segments are joined at marked doors and junctions, so any place can reach any other place.' },
  { date: 'Oct 30', title: '1,194 joined routes', text: 'Every place connects to every other. Home v4 design and instant tab switching ship the same day.' },
  { date: 'Oct 31', title: 'Final polish', text: 'Place details v3, About v3 with an AR navigation guide, and steadier marker tracking.' },
];
---
<section id="journey" class="relative py-24 md:py-32">
  <div class="wrap grid gap-14 lg:grid-cols-[.8fr_1.2fr]">
    <div class="lg:sticky lg:top-28 lg:self-start">
      <p class="eyebrow reveal">The build</p>
      <h2 class="h-section mt-5 reveal">From one route to <span class="gold-text">a whole campus.</span></h2>
      <p class="lead mt-6 reveal">Built with the Prototyping Model: build a version, test it on campus, fix what broke, repeat. Every design was drawn in Figma first, then rebuilt in Unity.</p>
      <figure class="reveal mt-10 overflow-hidden rounded-2xl border border-white/10">
        <img src="/img/campus-gate03.webp" alt="Gate 03 (Pantua Gate) of Notre Dame of Marbel University" width="1344" height="513" loading="lazy" class="aspect-[16/8] w-full object-cover" />
        <figcaption class="bg-ink-2 px-4 py-3 text-xs text-mute">Gate 03, where the first route began.</figcaption>
      </figure>
    </div>
    <ol class="relative" data-timeline>
      <span class="absolute left-[7px] top-2 bottom-2 w-px bg-white/10" aria-hidden="true"><span class="timeline-fill absolute inset-x-0 top-0 h-full origin-top scale-y-0 bg-gradient-to-b from-gold to-leaf"></span></span>
      {items.map((it) => (
        <li class="timeline-item relative pl-10 pb-10 last:pb-0">
          <span class="absolute left-0 top-1.5 grid size-[15px] place-items-center rounded-full border border-gold/60 bg-ink"><span class="size-[7px] rounded-full bg-gold"></span></span>
          <p class="font-mono text-xs uppercase tracking-[.14em] text-gold">{it.date}</p>
          <h3 class="mt-2 text-xl font-semibold">{it.title}</h3>
          <p class="mt-2 max-w-xl text-[.95rem] leading-relaxed text-mute">{it.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
