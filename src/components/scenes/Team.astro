---
// Team and adviser: a portrait, full name (surname large, given names below) and role for each member.
import SceneHead from '../SceneHead.astro';
import { scenes } from '../../data/scenes';
const me = scenes.find((s) => s.id === 'team')!;
const team = [
  { photo: 'sa', given: 'Shuhari Alaihim', surname: 'Amoran', role: 'Full-stack developer' },
  { photo: 'br', given: 'Ben Raffy', surname: 'Herradura', role: 'Research, field mapping and 3D modeling' },
  { photo: 'ev', given: 'Edward', surname: 'Villanueva', role: 'Research and field mapping' },
];
---
<section class="scene scene-pad team" id="team" data-scene data-dwell={me.dwell}>
  <div class="wrap team__grid">
    <SceneHead id="team" title="Three students, one campus." lead="A capstone project of the BS Information Technology program at Notre Dame of Marbel University." />
    <ul class="team__row">
      {team.map((m) => (
        <li class="team__card rv">
          <picture class="team__photo">
            <source type="image/avif" srcset={`img/team-${m.photo}-480.avif 480w, img/team-${m.photo}-960.avif 960w`} sizes="(min-width: 52rem) 30vw, 9rem" />
            <img src={`img/team-${m.photo}-480.webp`} srcset={`img/team-${m.photo}-480.webp 480w, img/team-${m.photo}-960.webp 960w`} sizes="(min-width: 52rem) 30vw, 9rem" width="480" height="480" alt={`Portrait of ${m.given} ${m.surname}`} loading="lazy" decoding="async" />
          </picture>
          <!-- Read in name order (given names, then surname); shown with the surname on top. -->
          <h3 class="team__name"><span class="team__given">{m.given}</span> <span class="team__surname">{m.surname}</span></h3>
          <p class="team__role">{m.role}</p>
        </li>
      ))}
    </ul>
    <p class="team__adviser rv"><i class="fi-rr-graduation-cap" aria-hidden="true"></i><span><span class="t-small">Research Capstone adviser</span><b>Vince Marc B. Sabado, MSIT</b></span></p>
  </div>
</section>

<style is:global>
  .team__grid { display: grid; gap: clamp(2rem, 5vh, 3.5rem); }
  .team__row { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.25rem; }
  @media (min-width: 52rem) { .team__row { grid-template-columns: repeat(3, 1fr); gap: 1.75rem; } }
  .team__card { display: grid; gap: 0.35rem; align-content: start; padding: clamp(1.25rem, 3vw, 2rem); border-radius: 1.5rem; background: rgb(255 253 246 / 0.86); box-shadow: 0 0 0 2px var(--color-gold), 0 2rem 3rem -2.4rem rgb(138 90 0 / 0.6); }
  .team__photo { display: block; margin-bottom: 1.1rem; }
  @media (max-width: 51.99rem) {
    .team__card { grid-template-columns: clamp(6.5rem, 30vw, 9rem) 1fr; column-gap: 1.1rem; align-content: center; }
    .team__photo { grid-row: 1 / span 3; align-self: center; margin: 0; }
    .team__card .team__surname { font-size: clamp(1.9rem, 8.6vw, 2.9rem); }
  }
  .team__photo img { display: block; width: 100%; height: auto; aspect-ratio: 1; object-fit: cover; border-radius: 1rem; background: #fff; }
  .team__name { display: flex; flex-direction: column-reverse; align-items: start; gap: 0.6rem; margin: 0; }
  .team__surname { font-family: var(--font-display); font-size: clamp(3rem, 4.6vw, 4.25rem); font-weight: 400; line-height: 0.9; color: var(--color-gold-deep); letter-spacing: -0.02em; overflow-wrap: anywhere; }
  .team__given { font-family: var(--font-sans); font-size: 1.15rem; font-weight: 600; letter-spacing: 0; color: var(--color-ink); }
  .team__role { font-size: var(--fs-small); font-weight: 600; color: var(--color-gold-deep); }
  .team__adviser { display: flex; align-items: center; gap: 1rem; padding-top: 1.5rem; border-top: 1px solid var(--color-line); }
  .team__adviser i { display: grid; place-items: center; width: 2.75rem; height: 2.75rem; border-radius: 0.8rem; background: var(--color-forest); color: var(--color-gold); font-size: 1.1rem; }
  .team__adviser > span { display: grid; }
  .team__adviser b { font-size: 1.15rem; font-weight: 600; color: var(--color-ink); }
</style>
