---
interface Props { page?: 'home' | 'research' | '404'; }
const { page = 'home' } = Astro.props;
const home = page === 'home';
---
<header class="site-header" data-header>
  <div class="site-header__bar">
    <a class="brand" href={home ? '#top' : './'} aria-label="ExploreNDMU, home">
      <img src="img/logo-n-96.webp" alt="" width="34" height="34" />
      <span class="brand__word">Explore<span>NDMU</span></span>
    </a>
    <p class="light" data-light hidden>
      <span class="light__dot" aria-hidden="true"></span>
      <span>Live campus light, <time data-light-time></time></span>
    </p>
    <nav class="site-nav" aria-label="Primary">
      {home && (
        <button type="button" class="sound" data-sound aria-pressed="false" title="Play the app's voice in the turn and arrival scenes">
          <i class="fi-rr-volume-slash" data-sound-icon aria-hidden="true"></i>
          <span data-sound-label>Sound off</span>
        </button>
      )}
      <a class="site-nav__link" href={page === 'research' ? './' : 'research.html'}>{page === 'research' ? 'The app' : 'Research'}</a>
      <a class="site-nav__cta" href={home ? '#download' : './#download'}>Download</a>
    </nav>
  </div>
</header>

<style is:global>
  .site-header { position: fixed; inset: 0 0 auto 0; z-index: 60; padding: max(0.6rem, env(safe-area-inset-top)) clamp(0.6rem, 2.4vw, 2rem) 0; pointer-events: none; }
  .site-header__bar { pointer-events: auto; display: flex; align-items: center; gap: 0.75rem; max-width: 1480px; margin-inline: auto; min-height: 3.25rem; padding: 0.35rem 0.5rem 0.35rem 0.75rem; border-radius: 999px; transition: background-color 0.4s, box-shadow 0.4s; }
  .site-header.is-solid .site-header__bar { background: rgb(255 253 246 / 0.94); box-shadow: 0 0 0 1px rgb(10 90 49 / 0.12), 0 14px 34px -22px rgb(6 48 29 / 0.5); }
  @supports ((-webkit-backdrop-filter: blur(1px)) or (backdrop-filter: blur(1px))) {
    .site-header.is-solid .site-header__bar { background: rgb(255 253 246 / 0.74); -webkit-backdrop-filter: blur(18px) saturate(1.3); backdrop-filter: blur(18px) saturate(1.3); }
  }
  .brand { display: inline-flex; align-items: center; gap: 0.55rem; min-height: 2.75rem; text-decoration: none; color: var(--color-forest); font-weight: 600; font-size: 1.05rem; letter-spacing: -0.01em; }
  .brand img { flex: none; width: 2.1rem; height: 2.1rem; object-fit: contain; }
  .brand__word span { color: var(--color-gold-deep); }
  .light { display: inline-flex; align-items: center; gap: 0.5rem; margin: 0 auto 0 0.5rem; font-size: 0.8rem; font-weight: 500; color: var(--color-mute); white-space: nowrap; }
  .light[hidden] { display: none; }
  .light__dot { width: 0.5rem; height: 0.5rem; border-radius: 50%; background: var(--color-gold); box-shadow: 0 0 0 3px rgb(255 194 14 / 0.28); }
  .site-nav { display: flex; align-items: center; gap: 0.25rem; margin-left: auto; }
  .site-nav__link, .sound { display: inline-flex; align-items: center; gap: 0.5rem; min-height: 2.75rem; padding: 0 0.85rem; border: 0; border-radius: 999px; background: none; font-size: 0.92rem; font-weight: 500; color: var(--color-ink); text-decoration: none; transition: background-color var(--dur-micro); }
  .site-nav__link:hover, .sound:hover { background: rgb(10 90 49 / 0.08); }
  .sound[aria-pressed="true"] { background: var(--color-gold); color: var(--color-ink); }
  .site-nav__cta { display: inline-flex; align-items: center; min-height: 2.75rem; padding: 0 1.15rem; border-radius: 999px; background: var(--color-forest); color: #fff; font-size: 0.92rem; font-weight: 600; text-decoration: none; transition: background-color var(--dur-micro); }
  .site-nav__cta:hover { background: var(--color-forest-2); }
  @media (max-width: 47.99rem) {
    .brand__word, .site-nav__cta { display: none; }
    .light { font-size: 0.75rem; margin-left: 0.15rem; }
    .sound [data-sound-label] { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
    .sound { width: 2.75rem; padding: 0; justify-content: center; }
    .site-nav__link { padding: 0 0.7rem; }
  }
  @media (max-width: 22.4rem) { .light span:last-child { display: none; } }
</style>
