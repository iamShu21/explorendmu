---
const models = [
  { id: 'mary', name: 'Mother Mary', sub: 'Statue of Mother Mary, the Good Mother of the Marist family.', src: 'models/mother-mary.glb', marker: '/img/marker-mother_mary.webp', poster: '/img/screen-mary.webp' },
  { id: 'champagnat', name: 'St. Marcellin Champagnat', sub: 'Statue of St. Marcellin Champagnat, founder of the Marist Brothers.', src: 'models/champagnat.glb', marker: '/img/marker-champagnat.webp', poster: '/img/screen-champagnat.webp' },
];
---
<section id="models" class="relative overflow-hidden py-16 md:py-24">
  <div class="absolute inset-0 -z-10 bg-[radial-gradient(55%_45%_at_35%_55%,rgba(255,194,14,.22),transparent_70%)]" aria-hidden="true"></div>
  <div class="wrap">
    <div class="grid gap-6 lg:grid-cols-[1fr_auto] lg:items-end">
      <div class="max-w-2xl">
        <p class="eyebrow reveal">3D landmarks</p>
        <h2 class="h-section mt-5 reveal">Statues you can hold in your hand. <span class="gold-text">Try one here.</span></h2>
        <p class="lead mt-6 reveal">In the app, you scan a printed marker and the statue appears in AR. Here you can drag to turn the same models, pinch to zoom, and on Android tap “View in your space”.</p>
      </div>
      <div class="flex gap-2 reveal" role="tablist" aria-label="Choose a model">
        {models.map((m, i) => (
          <button role="tab" type="button" class:list={['chip !px-4 !py-2.5 !text-sm cursor-pointer transition-colors hover:border-forest/40', i === 0 && '!bg-forest !text-white !border-forest']} aria-selected={i === 0 ? 'true' : 'false'} data-model-tab={m.id}>{m.name}</button>
        ))}
      </div>
    </div>

    <div class="mt-10 grid gap-5 lg:grid-cols-[1.5fr_1fr]">
      <div class="card reveal relative overflow-hidden !bg-[linear-gradient(180deg,#ffffff,#fff6dc)]" >
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_72%,rgba(255,194,14,.35),transparent_55%)]" aria-hidden="true"></div>
                <div class="relative h-[420px] md:h-[540px]" data-model-host
          data-models={JSON.stringify(models.map(({ id, name, src }) => ({ id, name, src })))}>
          <div class="absolute inset-0 grid place-items-center text-sm font-medium text-mute" data-model-loading>
            <span class="flex items-center gap-3"><span class="size-2 animate-ping rounded-full bg-forest-2"></span><span data-model-status>Loading 3D model…</span></span>
          </div>
        </div>
        <p class="relative flex flex-wrap items-center justify-between gap-2 border-t border-forest/10 bg-white/70 px-5 py-3 text-xs font-medium text-mute">
          <span class="flex items-center gap-2"><i class="fi-rr-cube text-forest-2"></i><span data-model-name>{models[0].name}</span> · same model as in the app, compressed for the web</span>
          <span>Drag to rotate</span>
        </p>
      </div>

      <div class="grid gap-5">
        <div class="card reveal p-6">
          <p class="font-display text-lg font-semibold text-fg">How the scan works</p>
          <ol class="mt-4 space-y-3 text-sm leading-relaxed text-mute">
            <li class="flex gap-3"><span class="font-mono font-semibold text-gold-deep">1</span>Open the centre Scan tab. The app asks for the camera with Android’s own prompt.</li>
            <li class="flex gap-3"><span class="font-mono font-semibold text-gold-deep">2</span>Hold the phone about an arm’s length from a printed marker.</li>
            <li class="flex gap-3"><span class="font-mono font-semibold text-gold-deep">3</span>AR Foundation recognises the image and the statue appears, facing you.</li>
          </ol>
                  </div>
        <div class="grid grid-cols-3 gap-3 reveal">
          <figure class="card overflow-hidden p-2"><img src="/img/marker-mother_mary.webp" alt="Mother Mary marker" width="640" height="640" loading="lazy" class="rounded-xl" /><figcaption class="px-1 pt-2 text-[.72rem] font-medium text-mute">Mother Mary</figcaption></figure>
          <figure class="card overflow-hidden p-2"><img src="/img/marker-champagnat.webp" alt="Champagnat marker" width="640" height="640" loading="lazy" class="rounded-xl" /><figcaption class="px-1 pt-2 text-[.72rem] font-medium text-mute">Champagnat</figcaption></figure>
          <figure class="card overflow-hidden p-2"><img src="/img/marker-stallion.webp" alt="Bronze Stallion marker" width="640" height="640" loading="lazy" class="rounded-xl" /><figcaption class="px-1 pt-2 text-[.72rem] font-medium text-mute">Stallion</figcaption></figure>
        </div>
        <div class="card reveal flex gap-4 p-5">
          <span class="icon-tile size-10 shrink-0"><i class="fi-rr-info"></i></span>
          <p class="text-sm leading-relaxed text-mute">
            <span class="font-semibold text-fg">Bronze Stallion is in the app only.</span>
            The model is “Horse Run Cycle On Place” by Amitesh Nandan (Sketchfab), licensed CC BY-ND 4.0, and its credit
            is shown in the app. We don’t publish our adjusted copy here, because the license doesn’t allow sharing changed versions.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
