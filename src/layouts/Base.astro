---
import '@fontsource/instrument-serif/latin-400.css';
import '@fontsource/instrument-serif/latin-400-italic.css';
import '@fontsource-variable/inter/wght.css';
import '../styles/global.css';
import displayFont from '@fontsource/instrument-serif/files/instrument-serif-latin-400-normal.woff2?url';
import textFont from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Intro from '../components/Intro.astro';
import TourBar from '../components/TourBar.astro';
import { LIVE_URL } from '../config';

interface Props { title: string; description: string; page?: 'home' | 'research' | '404'; }
const { title, description, page = 'home' } = Astro.props;
const site = Astro.site?.href ?? LIVE_URL;
const canonical = new URL(page === 'home' ? '' : page === 'research' ? 'research.html' : '404.html', site).href;
const ogImage = new URL('og.jpg', site).href;
// The 404 page can be served from any depth on GitHub Pages, so it alone needs a base address.
const base404 = page === '404' && import.meta.env.PROD ? new URL(site).pathname : null;
---
<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    {base404 && <base href={base404} />}
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fffdf6" />
    {page === '404' ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/png" sizes="32x32" href="logo-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="logo-192.png" />
    <link rel="apple-touch-icon" href="logo-192.png" />
    <link rel="preload" as="font" type="font/woff2" href={displayFont} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={textFont} crossorigin />
    <slot name="head" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ExploreNDMU" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="ExploreNDMU: gold AR arrows on a campus walkway at Notre Dame of Marbel University" />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      (function () {
        var d = document.documentElement, q = new URLSearchParams(location.search);
        d.classList.remove('no-js');
        var reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduced) d.classList.add('reduced');
        if (q.get('defense') === '1') d.classList.add('defense');
        // The intro plays once per visit, never with reduced motion, and not when a tour is asked for in the address.
        var seen = false;
        try { seen = sessionStorage.getItem('ndmu-intro') === '1'; } catch (e) {}
        if (!seen && !reduced && !q.has('tour') && !q.has('nointro')) {
          d.classList.add('intro-on');
          try { sessionStorage.setItem('ndmu-intro', '1'); } catch (e) {}
        }
      })();
    </script>
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'SoftwareApplication',
      name: 'ExploreNDMU',
      applicationCategory: 'TravelApplication',
      operatingSystem: 'Android',
      description,
      url: site,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'PHP' },
    })} />
  </head>
  <body class="grain" data-page={page}>
    <a href="#main" class="sr-only-focus btn btn-gold" style="position:fixed;top:.75rem;left:.75rem;z-index:300">Skip to content</a>
    <!-- The living gradient. Without WebGL the CSS gradient on <body> shows instead. -->
    <canvas class="gradient" data-gradient aria-hidden="true"></canvas>
    {page === 'home' && <Intro />}
    <Header page={page} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    {page === 'home' && <TourBar />}
    <div class="cursor" data-cursor aria-hidden="true"></div>
    <div class="blank" data-blank hidden></div>
  </body>
</html>

<style is:global>
  .gradient { position: fixed; inset: 0; width: 100%; height: 100%; z-index: -1; pointer-events: none; opacity: 0; transition: opacity 1.2s ease; }
  .gradient.is-live { opacity: 1; }

  /* gold ring cursor: desktop pointers only, switched on by JS */
  .cursor { position: fixed; left: 0; top: 0; z-index: 90; width: 2.25rem; height: 2.25rem; margin: -1.125rem 0 0 -1.125rem; border-radius: 50%; pointer-events: none; opacity: 0; box-shadow: inset 0 0 0 1.5px var(--color-gold), 0 0 0 1px rgb(138 90 0 / 0.25); transition: opacity 0.3s; will-change: transform; }
  .cursor.is-on { opacity: 1; }
  .cursor.is-down { box-shadow: inset 0 0 0 1.5px var(--color-gold), inset 0 0 0 1rem rgb(255 194 14 / 0.22); }
  html.defense .cursor { display: none; }

  /* presenter "blank screen" (B) */
  .blank { position: fixed; inset: 0; z-index: 250; background: #000; }
</style>
