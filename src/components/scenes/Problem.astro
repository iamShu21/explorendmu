---
import SceneHead from '../SceneHead.astro';
import { scenes } from '../../data/scenes';
const me = scenes.find((s) => s.id === 'problem')!;
const photos = [
  { src: 'welcome-campus', w: 1122, h: 841, half: 561, alt: 'The NDMU campus seen from inside the grounds, with tall trees and buildings behind them', cls: 'problem__photo--a' },
  { src: 'place-gate03', w: 960, h: 480, half: 480, alt: 'Gate 03, the Pantua Gate, one of the four ways into the campus', cls: 'problem__photo--b' },
  { src: 'campus-teston', w: 1400, h: 1050, half: 700, alt: 'Teston Hall, a long classroom building on campus', cls: 'problem__photo--c' },
];
---
<section class="scene scene-pad problem" id="problem" data-scene data-dwell={me.dwell}>
  <div class="wrap problem__grid">
    <div class="problem__copy">
      <SceneHead id="problem" title="A big campus is easy to get lost in." />
      <ul class="problem__list">
        <li class="rv"><span class="t-h3">New students</span><span class="t-body">look for a room they have never seen.</span></li>
        <li class="rv"><span class="t-h3">Parents</span><span class="t-body">look for the right office on a busy day.</span></li>
        <li class="rv"><span class="t-h3">Visitors</span><span class="t-body">look for someone to ask.</span></li>
      </ul>
      <p class="t-lead rv">Most newcomers ask around or follow the signs. ExploreNDMU adds another way: it puts the route on the ground in front of you.</p>
    </div>
    <div class="problem__photos" data-problem-photos>
      {photos.map((p) => (
        <figure class:list={['problem__photo', p.cls]} data-parallax>
          <picture>
            <source type="image/avif" srcset={`img/${p.src}-${p.half}.avif ${p.half}w, img/${p.src}.avif ${p.w}w`} sizes="(min-width: 60rem) 34vw, 70vw" />
            <img src={`img/${p.src}.webp`} srcset={`img/${p.src}-${p.half}.webp ${p.half}w, img/${p.src}.webp ${p.w}w`} sizes="(min-width: 60rem) 34vw, 70vw" width={p.w} height={p.h} alt={p.alt} loading="lazy" decoding="async" />
          </picture>
        </figure>
      ))}
    </div>
  </div>
</section>

<style is:global>
  .problem__grid { display: grid; gap: clamp(2.5rem, 6vw, 5rem); align-items: center; }
  .problem__copy { display: grid; gap: clamp(1.5rem, 4vh, 2.5rem); }
  .problem__list { list-style: none; margin: 0; padding: 0; display: grid; }
  .problem__list li { display: grid; gap: 0.15rem 1.5rem; padding: 1.05rem 0; border-top: 1px solid var(--color-line); }
  .problem__list li:last-child { border-bottom: 1px solid var(--color-line); }
  .problem__list .t-h3 { font-family: var(--font-display); color: var(--color-forest); }
  .problem__list .t-body { color: var(--color-ink); font-size: 1.05rem; }
  @media (min-width: 40rem) { .problem__list li { grid-template-columns: 9.5rem 1fr; align-items: baseline; } }

  .problem__photos { position: relative; aspect-ratio: 10 / 11; width: 100%; max-width: 40rem; margin-inline: auto; }
  .problem__photo { position: absolute; margin: 0; overflow: hidden; border-radius: 1.1rem; box-shadow: 0 2.2rem 3.4rem -2rem rgb(6 48 29 / 0.55); will-change: transform; background: var(--color-cream); }
  .problem__photo img { width: 100%; height: 100%; object-fit: cover; }
  .problem__photo picture { display: block; width: 100%; height: 100%; }
  .problem__photo--a { left: 0; top: 0; width: 72%; aspect-ratio: 4 / 3; }
  .problem__photo--b { right: 0; top: 34%; width: 58%; aspect-ratio: 2 / 1; z-index: 2; }
  .problem__photo--c { left: 9%; bottom: 0; width: 62%; aspect-ratio: 4 / 3; z-index: 1; }
  @media (min-width: 60rem) { .problem__grid { grid-template-columns: 1.05fr 0.95fr; } }
</style>
