---
import Base from '../layouts/Base.astro';
import Hero from '../components/scenes/Hero.astro';
import { FACTS } from '../config';
---
<Base
  title="ExploreNDMU: find your way around NDMU in Augmented Reality"
  description={`An Android app that guides you to ${FACTS.placesWithRoutes} places at Notre Dame of Marbel University with gold AR arrows on the real walkway, spoken turns and a place card on arrival. Works fully offline.`}
>
  <link slot="head" rel="preload" as="image" type="image/avif" imagesrcset="img/hero-island-720.avif 720w, img/hero-island-1440.avif 1440w" imagesizes="(min-width: 60rem) 66vw, 100vw" fetchpriority="high" />
  <Hero />
  <script>
    import '../scripts/main.js';
  </script>
</Base>
