---
// The end of the route. The gold path stops above an arrival card styled like the app's own:
// "You have arrived: ExploreNDMU", with the download, the research link and a QR code to open the page on a phone.
import QRCode from 'qrcode';
import DownloadButton from '../DownloadButton.astro';
import { LIVE_URL, APK_URL, REPO_API } from '../../config';
import { scenes, total } from '../../data/scenes';
const me = scenes.find((s) => s.id === 'download')!;
// Made once, when the site is built. It points at the live address.
const qr = await QRCode.toString(LIVE_URL, { type: 'svg', margin: 1, errorCorrectionLevel: 'M', color: { dark: '#06301d', light: '#ffffff' } });
---
<section class="scene download" id="download" data-scene data-dwell={me.dwell}>
  <div class="wrap download__inner">
    <p class="counter rv"><b>{String(total).padStart(2, '0')} / {String(total).padStart(2, '0')}</b><span>The end of the route</span></p>
    <article class="arrival" data-arrival aria-labelledby="arrival-title">
      <header class="arrival__bar" data-arrival-part>
        <span class="arrival__check"><i class="fi-rr-check" aria-hidden="true"></i></span>
        <div>
          <h2 id="arrival-title">You have arrived</h2>
          <p>ExploreNDMU</p>
        </div>
      </header>
      <div class="app-card arrival__card">
        <div class="arrival__head" data-arrival-part>
          <img src="img/logo-n-192.webp" width="56" height="56" alt="" loading="lazy" />
          <div>
            <h3>ExploreNDMU</h3>
            <p class="app-soft" style="color:#c9d8ce">Android. Free. Works fully offline.</p>
          </div>
        </div>
        <div data-arrival-part>
          <p class="app-label">GET THE APP</p>
          <div class="arrival__actions">
            <DownloadButton />
            <a class="btn btn-line arrival__ghost" href="research.html">Read the research</a>
          </div>
          {APK_URL && <p class="arrival__note" data-apk-count={`${REPO_API}/releases`} aria-live="polite" hidden></p>}
          {!APK_URL && <p class="arrival__note">The Android release is being prepared. This button will turn on when it is ready.</p>}
        </div>
        <div class="arrival__qr" data-arrival-part>
          <div class="arrival__code" role="img" aria-label="QR code that opens this page" set:html={qr} />
          <div>
            <p class="app-label">ON YOUR PHONE</p>
            <p class="arrival__scan">Scan to open on your phone</p>
            <p class="arrival__url">{LIVE_URL.replace(/^https?:\/\//, '').replace(/\/$/, '')}</p>
          </div>
        </div>
      </div>
      <button type="button" class="arrival__done" data-tour-jump="top" data-arrival-part><i class="fi-rr-check" aria-hidden="true"></i>Done</button>
    </article>
  </div>
</section>

<style is:global>
  .download__inner { display: grid; grid-template-columns: minmax(0, 1fr); justify-items: center; gap: 1.5rem; padding-top: clamp(9rem, 26vh, 16rem); padding-bottom: clamp(5rem, 12vh, 8rem); }
  .arrival { width: min(100%, 30rem); display: grid; grid-template-columns: minmax(0, 1fr); gap: 0.75rem; will-change: transform, opacity; }
  .arrival__bar { display: flex; align-items: center; gap: 0.9rem; padding: 0.85rem 1.1rem; border-radius: 1.2rem; background: rgb(19 32 26 / 0.94); color: #fff; }
  .arrival__check { display: grid; place-items: center; flex: none; width: 2.9rem; height: 2.9rem; border-radius: 50%; background: #0a6b3b; color: #fff; box-shadow: 0 0 0 2px var(--color-gold); }
  .arrival__bar h2 { font-family: var(--font-sans); font-size: 1.2rem; font-weight: 600; letter-spacing: -0.01em; color: #fff; }
  .arrival__bar p { font-size: var(--fs-small); color: #c9d8ce; }
  .arrival__card { display: grid; gap: 1.25rem; }
  .arrival__head { display: flex; align-items: center; gap: 0.9rem; }
  .arrival__head img { flex: none; width: 3.5rem; height: 3.5rem; padding: 0.4rem; border-radius: 1rem; background: #fffdf6; }
  .arrival__head h3 { font-size: 1.35rem; }
  .arrival__actions { margin-top: 0.6rem; display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .arrival__actions .btn { white-space: normal; line-height: 1.2; max-width: 100%; }
  .arrival__card { grid-template-columns: minmax(0, 1fr); }
  .arrival__card .btn:disabled { background: rgb(255 255 255 / 0.1); color: #e3ece6; box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.22); }
  .arrival__card .arrival__ghost { background: rgb(255 255 255 / 0.08); color: #fff; box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.35); }
  .arrival__card .arrival__ghost:hover { background: rgb(255 255 255 / 0.16); }
  .arrival__note { margin-top: 0.6rem; font-size: var(--fs-small); color: #c9d8ce; }
  .arrival__qr { display: grid; grid-template-columns: auto 1fr; gap: 1.1rem; align-items: center; padding-top: 1.25rem; border-top: 1px solid rgb(255 255 255 / 0.14); }
  .arrival__qr > div:last-child { min-width: 0; }
  .arrival__code { width: clamp(5.5rem, 28vw, 7.5rem); height: clamp(5.5rem, 28vw, 7.5rem); padding: 0.35rem; border-radius: 0.8rem; background: #fff; }
  .arrival__code svg { display: block; width: 100%; height: 100%; }
  .arrival__scan { margin-top: 0.2rem; font-size: 1.1rem; font-weight: 600; color: #fff; }
  .arrival__url { margin-top: 0.2rem; font-size: var(--fs-small); color: #c9d8ce; overflow-wrap: anywhere; }
  .arrival__done { display: flex; align-items: center; justify-content: center; gap: 0.6rem; min-height: 3.25rem; border: 0; border-radius: 1.2rem; background: var(--color-gold); color: var(--color-ink); font-weight: 600; font-size: 1.05rem; transition: background-color var(--dur-micro); }
  .arrival__done:hover { background: var(--color-gold-2); }
</style>
