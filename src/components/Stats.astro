---
import net from '../data/campus-network.json';
import cards from '../data/info-cards.json';
const stats = [
  { value: net.counts.places, label: 'campus places with AR routes', icon: 'fi-rr-marker' },
  { value: net.counts.walked, label: 'routes walked on foot with GPS', icon: 'fi-rr-route' },
  { value: net.counts.joined, label: 'routes joined between places', icon: 'fi-rr-layers', fmt: true },
  { value: cards.cards.length, label: 'place info cards', icon: 'fi-rr-book-alt' },
  { value: 3, label: 'statues you can scan in 3D', icon: 'fi-rr-cube' },
];
---
<section id="stats" class="relative py-6 md:py-10">
  <div class="wrap">
    <div class="card overflow-hidden !rounded-[1.6rem]">
      <ul class="grid grid-cols-2 md:grid-cols-5">
        {stats.map((s, i) => (
          <li class:list={['reveal flex flex-col gap-2 px-5 py-6 md:px-6 md:py-8 border-forest/10', i > 0 && 'md:border-l', i % 2 === 1 && 'border-l md:border-l', i >= 2 && 'border-t md:border-t-0', i === 4 && 'col-span-2 md:col-span-1']}>
            <span class="icon-tile size-9"><i class={s.icon}></i></span>
            <p class="mt-2 font-display text-[clamp(2rem,3.6vw,2.8rem)] font-semibold leading-none tabular-nums text-fg">
              <span data-count={s.value} data-fmt={s.fmt ? '1' : undefined}>{s.fmt ? s.value.toLocaleString('en-US') : s.value}</span>
            </p>
            <p class="text-sm leading-snug text-mute">{s.label}</p>
          </li>
        ))}
      </ul>
    </div>
    <p class="caption mt-3 px-1">Counts from the team's route export of Oct 30, 2026</p>
  </div>
</section>
