---
import CampusNetwork from './CampusNetwork.astro';
---
<section id="top" class="relative isolate overflow-hidden pt-28 pb-16 md:pt-32 lg:min-h-[100svh] lg:pb-20">
  <!-- backdrop: the real walked network, fading into the page on the text side -->
  <div class="absolute inset-0 -z-10" aria-hidden="true">
    <div class="absolute inset-0 bg-[radial-gradient(60%_55%_at_78%_38%,rgba(255,194,14,.30),transparent_70%),radial-gradient(40%_40%_at_95%_90%,rgba(10,90,49,.10),transparent_70%)]"></div>
    <CampusNetwork id="hero-net" variant="hero" class="absolute right-[-30%] top-[6%] h-[70%] w-auto opacity-30 md:right-[-8%] md:top-[6%] md:h-[92%] md:opacity-100" />
    <div class="absolute inset-0 bg-[linear-gradient(180deg,rgba(255,250,240,.0)_0%,rgba(255,250,240,.0)_60%,rgba(255,250,240,.9)_100%)] md:bg-[linear-gradient(90deg,#fffaf0_20%,rgba(255,250,240,.75)_50%,rgba(255,250,240,0)_100%)]"></div>
  </div>

  <div class="wrap grid items-center gap-12 lg:grid-cols-[1.15fr_.85fr] lg:gap-14">
    <div>
      <p class="eyebrow hero-in">Capstone project · BS Information Technology · NDMU</p>
      <h1 class="mt-6 text-[clamp(2.35rem,5.6vw,4.6rem)] font-semibold leading-[1.02] text-fg" data-split>
        Find your way around NDMU, <span class="gold-text">in Augmented Reality.</span>
      </h1>
      <p class="lead mt-6 max-w-xl hero-in">
        ExploreNDMU is an Android app that leads you to 37 places on campus. It shows gold arrows on the real walkway,
        says each turn out loud, and shows a card about the place when you arrive.
      </p>
      <div class="mt-9 flex flex-wrap items-center gap-3 hero-in">
        <a href="#download" class="btn btn-gold magnetic"><i class="fi-rr-download"></i>Get the Android app</a>
        <a href="#engineering" class="btn btn-ghost magnetic">See how it was built<i class="fi-rr-arrow-small-right"></i></a>
      </div>
      <ul class="mt-10 flex flex-wrap gap-2 hero-in" aria-label="Built with">
        <li class="chip"><i class="fi-rr-cube text-forest-2"></i>Unity + C#</li>
        <li class="chip"><i class="fi-rr-camera text-forest-2"></i>AR Foundation + ARCore</li>
        <li class="chip"><i class="fi-rr-marker text-forest-2"></i>GPS + walked routes</li>
        <li class="chip"><i class="fi-rr-wifi-slash text-forest-2"></i>Data stored on the phone</li>
      </ul>
    </div>

    <div class="relative mx-auto w-[min(70vw,310px)] lg:w-[330px]" data-tilt>
      <div class="phone hero-phone">
        <div class="phone-screen">
          <img src="/img/screen-ar-arrows.webp" alt="ExploreNDMU AR navigation on a campus walkway: gold chevrons on the path and the prompt Turn left in 8 m" width="710" height="1108" fetchpriority="high" />
        </div>
      </div>
      <!-- floating callouts (real voice cue and arrival rule from the app) -->
      <div class="float-chip absolute -left-8 top-[16%] md:-left-24" style="animation: float-y 5s ease-in-out infinite">
        <div class="card flex items-center gap-3 rounded-2xl px-4 py-3 !bg-white/95">
          <span class="icon-tile size-9 !rounded-full"><i class="fi-rr-volume"></i></span>
          <div class="text-left">
            <p class="text-[.68rem] font-mono font-semibold uppercase tracking-wider text-mute">Voice</p>
            <p class="text-sm font-semibold text-fg">“Turn left now.”</p>
          </div>
        </div>
      </div>
      <div class="float-chip absolute -right-6 bottom-[16%] md:-right-16" style="animation: float-y 6s ease-in-out -2s infinite">
        <div class="card flex items-center gap-3 rounded-2xl px-4 py-3 !bg-white/95">
          <span class="relative grid size-9 place-items-center rounded-full bg-forest text-gold">
            <span class="absolute inset-0 rounded-full border-2 border-gold" style="animation: pulse-ring 2s ease-out infinite"></span>
            <i class="fi-rr-marker"></i>
          </span>
          <div class="text-left">
            <p class="text-[.68rem] font-mono font-semibold uppercase tracking-wider text-mute">Arrival</p>
            <p class="text-sm font-semibold text-fg">Gold pin within 60 m</p>
          </div>
        </div>
      </div>
      <p class="caption mt-5 text-center">On-campus field test · real capture</p>
    </div>
  </div>
</section>
